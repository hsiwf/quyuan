{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "屈原告默认能力:文件 I/O、目录选择、限定到百炼域的外部请求",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"fs:default",
		"fs:allow-read-text-file",
		"fs:allow-write-text-file",
		"fs:allow-read-dir",
		"fs:allow-exists",
		"fs:allow-mkdir",
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "**" }]
		},
		"dialog:allow-open",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "https://*.maas.aliyuncs.com/*" },
				{ "url": "https://dashscope.aliyuncs.com/*" }
			]
		}
	]
}
