{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "quyuan-voice",
	"version": "0.1.0",
	"identifier": "com.quyuan.voice",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5190",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "屈原 · 语音工作台",
				"width": 1280,
				"height": 860,
				"backgroundColor": "#0b0f14"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false,
		"category": "Productivity",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		]
	}
}
